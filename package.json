{
    "name": "saas_panel",
    "version": "1.0.5",
    "description": "Saas panel",
    "author": "",
    "license": "",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "lint": "ng lint",
        "lint:fix": "ng lint --fix",
        "dev": "ng serve --open",
        "prettier": "prettier --write \"src/**/*.{ts,html,scss}\"",
        "prettier-check": "prettier --list-different \"src/**/*.{ts,html,scss}\"",
        "docker:dev": "docker compose up dev",
        "docker:build": "docker compose run --rm build",
        "docker:down": "docker compose down",
        "deploy": "npm run build && wrangler deploy --autoconfig=false",
        "deploy:dry": "npm run build && wrangler deploy --dry-run --autoconfig=false",
        "preview": "npm run build && wrangler dev --autoconfig=false"
    },
    "dependencies": {
